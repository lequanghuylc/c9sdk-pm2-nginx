[supervisord]
nodaemon=true

[program:pm2]
command=pm2 start /root/c9sdk/server.js --name="c9sdk" -- -w / -l 0.0.0.0 -p 3399 -a c9sdk:$C9SDK_PASSWORD

[program:git-project-deployment]
command=/root/pm2-server-managers/detect-git-repo-deployment.sh
stdout_logfile=/root/pm2-server-managers/logfile.log
stderr_logfile=/root/pm2-server-managers/error.log

[program:nginx]
command=/bin/bash -c "/root/pm2-server-managers/ensure-ide-route.sh; exec nginx -g 'daemon off;'"

; keeps <domain>/ide pointing to the IDE in every server block, also the ones
; (re)generated by a deployed project's setup-nginx.sh
[program:ide-route]
command=/root/pm2-server-managers/ensure-ide-route.sh --reload --watch 10
stdout_logfile=/root/pm2-server-managers/ide-route.log
redirect_stderr=true

[program:cron]
command=cron -f

[program:sample-app]
command=/root/sample-app/start.sh
autorestart=unexpected
exitcodes=0
stdout_logfile=/root/sample-app/logfile.log
stderr_logfile=/root/sample-app/error.log

[program:initial_command]
command=/root/initial_command.sh
stdout_logfile=/root/initial_command.log
stderr_logfile=/root/initial_command_error.log