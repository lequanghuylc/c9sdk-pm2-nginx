# Deprecated as a build entrypoint.
#
# Previously: FROM lequanghuylc/c9sdk-pm2-ubuntu:latest (required a Hub push).
# Now: Railway builds the in-repo Dockerfile so you can deploy an untested
# branch without publishing. See railway.json → build.dockerfilePath.
#
# Local: docker buildx build --platform linux/amd64 -f Dockerfile \
#          -t lequanghuylc/c9sdk-pm2-ubuntu:railway .

FROM ubuntu:22.04
RUN echo "ERROR: Use Dockerfile (railway.json points there). Dockerfile.railway no longer FROM the Hub image." >&2 && exit 1
